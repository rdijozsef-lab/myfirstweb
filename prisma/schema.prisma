generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  OPERATOR
  SALES
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  OFFER_SENT
  WAITING_FEEDBACK
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  PHONE
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  REFERRAL
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EventType {
  MEETING
  CALL
  DEADLINE
  BOOKING
  SOCIAL
  INTERNAL
}

enum ContactType {
  PERSON
  COMPANY
}

enum ContactStatus {
  LEAD
  ACTIVE_CLIENT
  RETURNING_CLIENT
  CLOSED_CLIENT
  LOST
}

enum ActivityEntityType {
  AUTH
  CONTACT
  LEAD
  TASK
  CALENDAR_EVENT
  MESSAGE
  PAGE
  QUOTE_REQUEST
}

enum ActivityActionType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  COMPLETED
  PUBLISHED
  LOGIN
}

enum MessageChannel {
  CONTACT_FORM
  EMAIL
  CHAT
  PHONE_NOTE
  INTERNAL
}

enum MessageStatus {
  NEW
  WAITING_REPLY
  IN_PROGRESS
  CLOSED
  SPAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL_NOTE
}

enum QuoteRequestStatus {
  NEW
  REVIEWED
  QUALIFIED
  CONVERTED_TO_LEAD
  CLOSED
}

enum PageType {
  LANDING
  CONTENT
  SYSTEM
  PRESET
}

enum PublishStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum PageBlockType {
  HERO
  TEXT
  IMAGE_TEXT
  SERVICES
  REFERENCES
  CTA
  TESTIMONIALS
  FAQ
  GALLERY
  VIDEO
  BLOG_LIST
  CONTACT
  FORM
}

enum MediaKind {
  IMAGE
  DOCUMENT
  VIDEO_LINK
}

enum ProjectStatus {
  PREPARATION
  IN_PROGRESS
  HANDOVER
  CLOSED
}

enum ProjectRole {
  OWNER
  CUSTOMER
  TECH_INSPECTOR
  FMV
  PROJECT_MANAGER
  SUBCONTRACTOR
}

enum ProjectPermissionLevel {
  FULL
  MANAGE
  CONTRIBUTE
  COMMENT
  VIEW_APPROVE
  VIEW_ONLY
}

enum ProjectTaskType {
  EXECUTION
  CUSTOMER_DECISION
}

enum ProjectTaskStatus {
  NEW
  IN_PROGRESS
  DONE
  WAITING_APPROVAL
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectEventType {
  TASK_DEADLINE
  WORK_START
  MEETING
  HANDOVER
}

enum ProjectIssueCategory {
  TECHNICAL
  DELAY
  MISSING
  DECISION
}

enum ProjectIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ProjectDocumentCategory {
  PLAN
  PHOTO
  CONTRACT
  OTHER
}

enum ProjectDocumentScope {
  PLAN_PACKAGE
  WORKFLOW
  CONTRACTOR
  FINANCIAL
  GENERAL
}

enum ProjectPlanChecklistType {
  FLOOR_PLAN
  SECTIONS
  FACADES
  MECHANICAL_PLAN
  ELECTRICAL_PLAN
  STRUCTURAL_PLAN
  SITE_PLAN
  OTHER
}

enum ProjectWorkflowTemplate {
  EARTHWORK
  MASONRY
  ROOFING
  FACADE
  OPENINGS
  ELECTRICAL
  MECHANICAL
  INTERIOR
  PAINTING
  TILING
  OTHER
}

enum ProjectWorkflowStatus {
  PLANNED
  ACTIVE
  WAITING
  DONE
}

enum ProjectTechnicalSection {
  BASICS
  STRUCTURES
  EXTERIOR
  INTERIOR
  MEP
  SUMMARIES
  SUBCONTRACTOR_PREP
}

enum ProjectTechnicalValueType {
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
}

model User {
  id              String           @id @default(cuid())
  username        String           @unique
  email           String           @unique
  name            String
  passwordHash    String
  role            UserRole         @default(ADMIN)
  isActive        Boolean          @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ownedContacts   Contact[]        @relation("ContactOwner")
  leads           Lead[]           @relation("LeadOwner")
  tasks           Task[]           @relation("TaskOwner")
  events          CalendarEvent[]  @relation("EventOwner")
  activityLogs    ActivityLog[]    @relation("ActivityActor")
  assignedThreads MessageThread[]  @relation("MessageAssignee")
  messageEntries  MessageEntry[]   @relation("MessageAuthor")
  createdPages    Page[]           @relation("PageCreator")
  updatedPages    Page[]           @relation("PageUpdater")
  mediaAssets     MediaAsset[]
  quoteRequests   QuoteRequest[]   @relation("QuoteRequestAssignee")
  createdProjects Project[]        @relation("ProjectCreator")
  projectEvents   ProjectEvent[]   @relation("ProjectEventCreator")
  projectTasks    ProjectTask[]    @relation("ProjectTaskCreator")
  siteLogEntries  ProjectSiteLogEntry[] @relation("ProjectSiteLogCreator")
  projectIssues   ProjectIssue[]   @relation("ProjectIssueCreator")
  projectDocuments ProjectDocument[] @relation("ProjectDocumentUploader")
  projectWorkflows ProjectWorkflow[] @relation("ProjectWorkflowCreator")
}

model Contact {
  type        ContactType  @default(PERSON)
  id          String       @id @default(cuid())
  name        String
  company     String?
  email       String?
  phone       String?
  secondaryPhone String?
  addressLine String?
  city        String?
  postalCode  String?
  country     String?
  website     String?
  notes       String?
  tags        String?
  source      LeadSource   @default(WEBSITE)
  status      ContactStatus @default(LEAD)
  statusLabel String       @default("Új kapcsolat")
  ownerId     String?
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  leads       Lead[]
  tasks       Task[]
  events      CalendarEvent[]
  messageThreads MessageThread[]
  activityLogs ActivityLog[]
  quoteRequests QuoteRequest[]
  projectMembers ProjectMember[]
}

model Lead {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      LeadStatus  @default(NEW)
  source      LeadSource  @default(WEBSITE)
  pipeline    String?
  valueLabel  String?
  estimatedValue Float?
  currency    String?
  dueAt       DateTime?
  closedAt    DateTime?
  lostReason  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  contactId   String?
  ownerId     String?
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner       User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks       Task[]
  events      CalendarEvent[]
  activityLogs ActivityLog[]
  quoteRequests QuoteRequest[]
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  moduleKey   String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contactId   String?
  leadId      String?
  ownerId     String?
  contact     Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner       User?         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activityLogs ActivityLog[]
}

model CalendarEvent {
  id          String      @id @default(cuid())
  title       String
  description String?
  type        EventType   @default(MEETING)
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  meetingUrl  String?
  isAllDay    Boolean     @default(false)
  reminderAt  DateTime?
  moduleKey   String?
  contactId   String?
  leadId      String?
  ownerId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner       User?       @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activityLogs ActivityLog[]
}

model ActivityLog {
  id          String             @id @default(cuid())
  entityType  ActivityEntityType
  action      ActivityActionType
  entityId    String
  summary     String
  payloadJson String?
  actorUserId String?
  contactId   String?
  leadId      String?
  taskId      String?
  eventId     String?
  createdAt   DateTime           @default(now())
  actor       User?              @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  contact     Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead        Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  task        Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  event       CalendarEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model MessageThread {
  id               String         @id @default(cuid())
  channel          MessageChannel
  status           MessageStatus  @default(NEW)
  subject          String?
  previewText      String?
  lastMessageAt    DateTime?
  isUnread         Boolean        @default(true)
  contactId        String?
  assignedToUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  contact          Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo       User?          @relation("MessageAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  entries          MessageEntry[]
}

model MessageEntry {
  id           String           @id @default(cuid())
  direction    MessageDirection
  senderName   String?
  senderEmail  String?
  body         String
  sentAt       DateTime?
  createdAt    DateTime         @default(now())
  threadId     String
  authorUserId String?
  thread       MessageThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author       User?            @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
}

model QuoteRequest {
  id               String             @id @default(cuid())
  status           QuoteRequestStatus @default(NEW)
  serviceType      String?
  budgetLabel      String?
  deadlineLabel    String?
  message          String?
  sourcePage       String?
  submittedAt      DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  contactId        String?
  leadId           String?
  assignedToUserId String?
  contact          Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead             Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo       User?              @relation("QuoteRequestAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  answers          QuoteRequestAnswer[]
}

model QuoteRequestAnswer {
  id             String       @id @default(cuid())
  fieldKey       String
  fieldLabel     String
  value          String
  createdAt      DateTime     @default(now())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
}

model Page {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  type            PageType      @default(CONTENT)
  status          PublishStatus @default(DRAFT)
  excerpt         String?
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  scheduledFor    DateTime?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       User?         @relation("PageCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?         @relation("PageUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  blocks          PageBlock[]
}

model PageBlock {
  id        String        @id @default(cuid())
  type      PageBlockType
  position  Int
  dataJson  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  pageId    String
  page      Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id               String    @id @default(cuid())
  kind             MediaKind
  title            String
  fileName         String?
  mimeType         String?
  filePath         String?
  altText          String?
  caption          String?
  folder           String?
  tags             String?
  sizeBytes        Int?
  width            Int?
  height           Int?
  uploadedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  uploadedBy       User?     @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
}

model Project {
  id              String          @id @default(cuid())
  name            String
  code            String?
  addressLine     String?
  city            String?
  postalCode      String?
  status          ProjectStatus   @default(PREPARATION)
  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  description     String?
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       User?           @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  members         ProjectMember[]
  tasks           ProjectTask[]
  events          ProjectEvent[]
  siteLogEntries  ProjectSiteLogEntry[]
  issues          ProjectIssue[]
  documents       ProjectDocument[]
  workflows       ProjectWorkflow[]
  technicalParameters ProjectTechnicalParameter[]
}

model ProjectMember {
  id              String                 @id @default(cuid())
  projectId       String
  contactId       String?
  name            String
  phone           String?
  email           String?
  role            ProjectRole
  permissionLevel ProjectPermissionLevel @default(CONTRIBUTE)
  isActive        Boolean                @default(true)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact         Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTasks   ProjectTask[]          @relation("ProjectTaskAssignee")
  approvedTasks   ProjectTask[]          @relation("ProjectTaskApprover")
  ownedWorkflows  ProjectWorkflow[]      @relation("ProjectWorkflowContractor")
}

model ProjectTask {
  id                 String               @id @default(cuid())
  projectId          String
  workflowId         String?
  title              String
  description        String?
  type               ProjectTaskType      @default(EXECUTION)
  status             ProjectTaskStatus    @default(NEW)
  priority           ProjectTaskPriority  @default(MEDIUM)
  assigneeMemberId   String?
  dueAt              DateTime?
  completedAt        DateTime?
  approvalRequired   Boolean              @default(false)
  approvedAt         DateTime?
  approvedByMemberId String?
  createdByUserId    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow           ProjectWorkflow?     @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  assignee           ProjectMember?       @relation("ProjectTaskAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  approvedBy         ProjectMember?       @relation("ProjectTaskApprover", fields: [approvedByMemberId], references: [id], onDelete: SetNull)
  createdBy          User?                @relation("ProjectTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  events             ProjectEvent[]
  issues             ProjectIssue[]
  documents          ProjectDocument[]
}

model ProjectWorkflow {
  id                 String                  @id @default(cuid())
  projectId          String
  contractorMemberId String?
  name               String
  template           ProjectWorkflowTemplate @default(OTHER)
  status             ProjectWorkflowStatus   @default(PLANNED)
  contractorCompany  String?
  contractorName     String?
  contractorPhone    String?
  contractorEmail    String?
  customerSelections String?
  specificationNotes String?
  createdByUserId    String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractorMember   ProjectMember?          @relation("ProjectWorkflowContractor", fields: [contractorMemberId], references: [id], onDelete: SetNull)
  createdBy          User?                   @relation("ProjectWorkflowCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  documents          ProjectDocument[]
  tasks              ProjectTask[]
}

model ProjectEvent {
  id              String           @id @default(cuid())
  projectId       String
  taskId          String?
  title           String
  type            ProjectEventType @default(MEETING)
  startsAt        DateTime
  endsAt          DateTime?
  location        String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task            ProjectTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("ProjectEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
}

model ProjectSiteLogEntry {
  id              String    @id @default(cuid())
  projectId       String
  entryDate       DateTime
  attendees       String?
  completedWork   String
  issues          String?
  weather         String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("ProjectSiteLogCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
}

model ProjectIssue {
  id              String               @id @default(cuid())
  projectId       String
  taskId          String?
  title           String
  description     String?
  category        ProjectIssueCategory @default(TECHNICAL)
  status          ProjectIssueStatus   @default(OPEN)
  responsibleName String?
  createdByUserId String?
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task            ProjectTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy       User?                @relation("ProjectIssueCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
}

model ProjectDocument {
  id               String                  @id @default(cuid())
  projectId        String
  taskId           String?
  workflowId       String?
  workflowRequirementKey String?
  title            String
  category         ProjectDocumentCategory @default(OTHER)
  scope            ProjectDocumentScope    @default(GENERAL)
  planChecklistType ProjectPlanChecklistType?
  linkUrl          String
  tags             String?
  notes            String?
  uploadedByUserId String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task             ProjectTask?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workflow         ProjectWorkflow?        @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  uploadedBy       User?                   @relation("ProjectDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
}

model ProjectTechnicalParameter {
  id          String                    @id @default(cuid())
  projectId   String
  section     ProjectTechnicalSection
  groupKey    String
  paramKey    String
  label       String
  valueType   ProjectTechnicalValueType
  unit        String?
  textValue   String?
  numberValue Float?
  booleanValue Boolean?
  notes       String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, paramKey])
  @@index([projectId, section])
}
